# .env.example — Copy to .env and fill in real values
# Never commit the actual .env file to version control

# =============================================================================
# Required — app will NOT start without these
# =============================================================================

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-anon-public-key-here

# =============================================================================
# Optional — sensible defaults are provided
# =============================================================================

# Application settings
ENVIRONMENT=development
DEBUG=false
SECRET_KEY=change-me-in-production

# Supabase service role key (required for admin operations)
SUPABASE_SERVICE_KEY=

# CORS — comma-separated list of allowed origins
# Local dev:
#   http://localhost:5173  → landing/ (Vite)
#   http://localhost:4000  → web/ (Next.js dashboard — port defined in web/package.json)
# Production:
#   https://aideas.ca       → landing/
#   https://app.aideas.ca   → web/
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4000,https://aideas.ca,https://app.aideas.ca

# =============================================================================
# Future phases — not required for Phase 1
# =============================================================================

# Resend (Phase 4 — Email notifications)
RESEND_API_KEY=
EMAIL_FROM=noreply@aideas.com

# Stripe (Phase 3 — Billing)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
