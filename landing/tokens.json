{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "_meta": {
    "name": "AIDEAS design tokens",
    "version": "1.0.0",
    "source": "landing/public/assets/css/main.css (Orisa template :root block)",
    "extracted": "2026-05-21",
    "notes": "Single source of truth for design tokens shared by the landing/ (Bootstrap + custom CSS) and web/ (Tailwind 4 + shadcn/ui) modules. landing/ consumes via CSS variables (already wired in main.css). web/ consumes via tailwind.config.ts which reads this file at build time. To update: edit landing/tokens.json, then run `node scripts/sync-tokens.js` from repo root to mirror into web/tokens.json. CI runs `scripts/check-tokens-sync.js` to fail if they drift."
  },

  "colors": {
    "primary": {
      "DEFAULT": "#F0460E",
      "_label": "Orisa orange — used for CTAs and accent text"
    },

    "neutral": {
      "0": "#FEFEFE",
      "50": "#F2F2F2",
      "100": "#DFDFDF",
      "200": "#CDCCCC",
      "300": "#B7B7B7",
      "500": "#585959",
      "700": "#303030",
      "800": "#212121",
      "900": "#1D1D1D",
      "950": "#0F0F0F"
    },

    "neutralDark": {
      "0": "#0C0C0C",
      "50": "#141414",
      "100": "#212121",
      "200": "#2D2D2D",
      "300": "#404040",
      "500": "#B3B3B3",
      "700": "#535353",
      "800": "#EAEAEA",
      "900": "#EFEFEF",
      "950": "#F4F4F4"
    },

    "common": {
      "white": "#FFFFFF",
      "black": "#1E1E1E",
      "bubbles": "#E1EEB7",
      "darkBubbles": "#040403"
    },

    "grey": {
      "1": "#5E5959",
      "2": "#F3F3F3",
      "3": "#B6BCC6",
      "4": "#F6F6F6",
      "5": "#D7CDCD"
    },

    "gradient": {
      "primary": "linear-gradient(90deg, #A020F0 0%, #00FFD1 100%)"
    }
  },

  "typography": {
    "families": {
      "body": "'DM Sans', sans-serif",
      "heading": "'DM Sans', sans-serif",
      "icon": "'Font Awesome 6 Pro'"
    },

    "weights": {
      "light": 300,
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700,
      "extrabold": 800,
      "black": 900
    },

    "sizes": {
      "_label": "Two scales: body sizes (fs-*) and display sizes (ds-*). Source: docs/typography.html and main.css.",
      "body": {
        "fs-1": "40px",
        "fs-2": "32px",
        "fs-3": "28px",
        "fs-4": "24px",
        "fs-5": "20px",
        "fs-6": "16px",
        "fs-7": "14px",
        "fs-8": "12px"
      },
      "display": {
        "ds-1": "80px",
        "ds-2": "72px",
        "ds-3": "64px",
        "ds-4": "56px",
        "ds-5": "48px",
        "ds-6": "40px"
      },
      "displayXs": {
        "ds-xs-1": "64px",
        "ds-xs-2": "56px",
        "ds-xs-3": "48px",
        "ds-xs-4": "36px",
        "ds-xs-5": "28px",
        "ds-xs-6": "24px"
      },
      "heading": {
        "h1": "60px",
        "h2": "48px",
        "h3": "38px",
        "h4": "31px",
        "h5": "25px",
        "h6": "20px"
      },
      "fontVars": {
        "body": "14px",
        "label": "12px",
        "md": "16px",
        "lg": "20px",
        "xl": "22px",
        "2xl": "28px",
        "3xl": "32px",
        "ds-1": "124px",
        "10": "10px",
        "24": "24px"
      }
    },

    "lineHeight": {
      "body": 1.5,
      "heading": 1.2
    }
  },

  "spacing": {
    "_label": "Bootstrap 5 default scale (rem). 0.25rem step.",
    "0": "0",
    "1": "0.25rem",
    "2": "0.5rem",
    "3": "1rem",
    "4": "1.5rem",
    "5": "3rem"
  },

  "radius": {
    "_label": "Bootstrap defaults + the template's custom rounded-3 (12px) used on cards and buttons.",
    "none": "0",
    "sm": "0.25rem",
    "DEFAULT": "0.375rem",
    "lg": "0.5rem",
    "xl": "0.75rem",
    "2xl": "12px",
    "3xl": "16px",
    "pill": "50rem",
    "full": "9999px"
  },

  "shadows": {
    "1": "0px 20px 60px 0px rgba(0, 0, 0, 0.08)"
  },

  "breakpoints": {
    "_label": "Bootstrap 5 breakpoints. min-width.",
    "sm": "576px",
    "md": "768px",
    "lg": "992px",
    "xl": "1200px",
    "xxl": "1400px"
  },

  "motion": {
    "ease": {
      "basic": "cubic-bezier(0.625, 0.05, 0, 1)"
    },
    "duration": {
      "fast": "150ms",
      "DEFAULT": "300ms",
      "slow": "500ms"
    }
  }
}
