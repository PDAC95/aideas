# AIDEAS landing — environment variables
#
# Copy to `.env.local` and adjust per environment.
# Vite only exposes vars prefixed with `VITE_` to the browser.

# Where the dashboard (web/) lives. Used by:
#   - MainMenu (Log in / Sign up links)
#   - Footer2 (Log in / Sign up links)
#   - any CTAs pointing into the authenticated app
VITE_APP_URL=http://localhost:4000

# Where the FastAPI backend (api/) lives. Used by:
#   - public contact form (POST /api/public/contact)
#   - public waitlist form (POST /api/public/waitlist)
VITE_API_URL=http://localhost:8000
